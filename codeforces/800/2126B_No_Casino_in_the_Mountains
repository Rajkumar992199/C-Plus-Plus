#include <bits/stdc++.h>
using namespace std;

int main() 
{
    int t = 1;
    cin >> t;
    while(t--) {
        long long n, k;
        cin >> n >> k;
        long long a[n + 1];
        for(int i = 1; i < n + 1; i++)
            cin >> a[i];
        long long ans = 0, cnt = 0;
        for(int i = 1; i < n + 1; i++)
        {
            if(a[i] == 1) {
                ans += (cnt + 1) / (k + 1);
                cnt = 0;
                continue;
            }
            else 
                cnt++;
        }
        ans += (cnt + 1) / (k + 1);
        cout << ans << endl;
    }
    return 0;
}